<!DOCTYPE html>
<html>
<style>
table, th, td {
  border:1px solid black;
}
table {
  border-collapse: collapse;
}
.container{
  display: grid;
  grid-template-areas: 
  	"header header"
    "menu content"
    "footer footer";
  grid-template-columns: auto auto auto;
  background-color: solid black;
  padding: 10px;
  justify-items: end;
}
.container div{
  background-color: #ffffff;
  border: 1px solid black;
  padding: 50px;
  font-size: 20px;
  text-align: center;
}
.container div.header{
	grid-area: header;
    text-align: center;
}
.container div.menu{
	display: flex;
    flex-direction: column;
    grid-area: menu;
	justify-items: center;
}
.container div.content{
	grid-area: content;
    font-family: 'Trebuchet MS', sans-serif;
}
.container div.footer{
	display: flex;
    flex-direction: column;
    grid-area: footer;
    text-align: center;
    justify-items: center;
}
.button {
  background-color: #5324e0;
  border: none;
  color: white;
  padding: 15px 32px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 16px;
  cursor: pointer;
}
@media screen and (max-width: 1024px) {
  .header {
    flex: 50%;
  }
  .column {
  	flex: 50%;
  }
  .menu {
  	flex: 50%;
  }
  .content {
	flex: 50%;
  }
  .footer {
  	flex: 50%;
  }
}

@media screen and (max-width: 768px) {
  .header {
    flex-direction: column;
  }
  .column {
  	flex-direction: column;
  }
  .menu {
  	flex-direction: column;
  }
  .content {
	flex-direction: column;
  }
  .footer {
  	flex-direction: column;
  }
}

div.a {
  width: 350px;
  height: 180px;
  background-color: SlateBlue;
  
  transition:
  	background-color 2s;
}

div.a:hover{
	background-color: #cdbdff;
}

div.b{
	transition:
    	opacity 1s;
}

div.b:hover{
	opacity: 0%
}

div.c{
	transition:
    	background-color 1s;
}

div.c:hover{
	background-color: #a98cff;
}

</style>
